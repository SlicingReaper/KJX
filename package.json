{
  "name": "kjx",
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:wikidata": "node scripts/fetch-wikidata.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data": "npm run data:wikidata && npm run data:build",
    "app": "vite build && electron .",
    "package": "vite build && electron-builder --mac --dir"
  },
  "author": "X",
  "license": "UNLICENSED",
  "description": "KJX — a world globe of shipwrecks, crashes, sunken vehicles and lost treasure",
  "dependencies": {
    "cesium": "^1.123.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^2.1.0"
  },
  "type": "module",
  "build": {
    "appId": "com.x.kjx",
    "productName": "KJX",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.reference",
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  },
  "private": true
}
